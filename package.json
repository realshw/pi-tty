{
  "name": "pi-tty",
  "version": "0.1.0",
  "description": "Pi package exposing one user-opened managed terminal session to the agent; tmux is the supported terminal frontend.",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "tmux",
    "bash",
    "terminal"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "typebox": "1.3.7"
  }
}
